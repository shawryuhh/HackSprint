# Documentation only; exports intentionally hard-lock to the local fixture service.
RELIEFMESH_MODE=fixture
RELIEFMESH_FIXTURE_URL=http://127.0.0.1:8094
# Proposed live URL: do not enable until Person 2 signs the contracts.
RELIEFMESH_BACKEND_URL=
