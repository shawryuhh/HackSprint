# Copy this file to .env and adjust values for your local setup.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://reliefmesh:reliefmesh@localhost:5432/reliefmesh

# Set to true to require an X-API-Key header on protected endpoints.
# Disabled by default so local dev/demo work without friction.
AUTH_ENABLED=false

# Shared API key checked when AUTH_ENABLED=true. Ignored otherwise.
API_KEY=change-me

# Comma-separated list of origins allowed for CORS. Use * for the hackathon demo.
CORS_ORIGINS=*

# Logical environment name, used only for informational purposes (e.g. in /health).
APP_ENV=local

# Optional. Overrides the database pytest runs against (a separate database
# on the same Postgres instance, never the one above). Defaults to
# reliefmesh_test on the same host/port/credentials if unset. See
# tests/conftest.py.
# TEST_DATABASE_URL=postgresql+psycopg2://reliefmesh:reliefmesh@localhost:5432/reliefmesh_test
